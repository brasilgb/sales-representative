# URL base da API do VetorPet (Laravel). Em desenvolvimento, use o IP da
# sua máquina na rede local (não "localhost"/"127.0.0.1": o emulador/aparelho
# físico não enxerga o host da sua máquina por esse endereço).
# Ex.: EXPO_PUBLIC_API_URL=http://192.168.2.54:8000
EXPO_PUBLIC_API_URL=http://192.168.2.54:8000
